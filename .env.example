# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Options: development, staging, production
ENV=production

# ==============================================================================
# DATABASE CONFIGURATION (Supabase / PostgreSQL)
# ==============================================================================
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://user:password@host.supabase.co:5432/postgres

# ==============================================================================
# VECTOR DATABASE CONFIGURATION (Qdrant)
# ==============================================================================
VECTOR_DB_PROVIDER=qdrant
QDRANT__URL=https://your-qdrant-cluster-url.aws.cloud.qdrant.io
QDRANT__API_KEY=your_qdrant_api_key_here
QDRANT__COLLECTION_NAME=enterprise_rag_vector_index

# ==============================================================================
# LLM & EMBEDDING PROVIDERS
# ==============================================================================
LLM__PROVIDER=openai

# OpenAI Configuration
LLM__OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cohere Configuration (Optional for Reranking/Embeddings)
LLM__COHERE_API_KEY=your_cohere_api_key_here

# Groq Configuration (Fast Inference)
LLM__GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama Configuration
LLM__OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# DOCUMENT PARSER CONFIGURATION (LlamaCloud)
# ==============================================================================
PARSER__LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
# Options: standard, agentic
PARSER__PARSING_TIER=agentic

# ==============================================================================
# INGESTION & CHUNKING STRATEGY
# ==============================================================================
CHUNKING__CHUNK_SIZE=1024
CHUNKING__CHUNK_OVERLAP=200